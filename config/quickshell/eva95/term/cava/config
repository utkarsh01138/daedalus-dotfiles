# Cava Audio Visualizer Configuration - NERV Tactical Equalizer
# Segmented frequency meters with gradient: Amber -> Crimson

[general]
framerate = 60

[input]
method = pulse
source = auto

[output]
method = ncurses
style = stereo
bar_width = 2
bar_spacing = 1

[color]
# NERV gradient: Blood Crimson (#E51D24) to Piercing Neon Red (#FF3B43)
gradient = 1
gradient_count = 6
gradient_color_1 = '#FF6B6B'
gradient_color_2 = '#FF4D4D'
gradient_color_3 = '#FF3B43'
gradient_color_4 = '#E51D24'
gradient_color_5 = '#BA181B'
gradient_color_6 = '#660708'

[smoothing]
noise_reduction = 75
monstercat = 1
waves = 0
gravity = 140

[eq]
1 = 0.8
2 = 0.9
3 = 1.0
4 = 1.1
5 = 1.2
