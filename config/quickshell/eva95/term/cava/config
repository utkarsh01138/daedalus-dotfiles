# Cava Audio Visualizer Configuration - EVA-95 Terminal Dogma Energy Spectrum
# Segmented frequency meters with gradient: Phosphor Green -> Amber -> Peak High-Beam Orange

[general]
framerate = 60

[input]
method = pulse
source = auto

[output]
method = ncurses
style = stereo
bar_width = 2
bar_spacing = 1

[color]
# EVA-95 1995 CRT gradient: Phosphor Mint Green to High-Beam Amber/Orange
gradient = 1
gradient_count = 6
gradient_color_1 = '#FFAA00'
gradient_color_2 = '#FF8800'
gradient_color_3 = '#FF6600'
gradient_color_4 = '#00FF66'
gradient_color_5 = '#00DD55'
gradient_color_6 = '#008833'

[smoothing]
noise_reduction = 75
monstercat = 1
waves = 0
gravity = 140

[eq]
1 = 0.8
2 = 0.9
3 = 1.0
4 = 1.1
5 = 1.2
