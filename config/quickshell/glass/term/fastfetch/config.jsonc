{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "/home/utki/.config/fastfetch/glass_logo.png",
        "width": 19,
        "height": 13,
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": " : ",
        "color": { "keys": "36", "title": "36", "output": "97", "separator": "90" },
        "percent": { "color": { "green": "36", "yellow": "36", "red": "91" } }
    },
    "modules": [
        "break",
        { "type": "custom", "format": "\u001b[1;36m[ DAEDALUS // CREATIVE STUDIO // GLASS ]\u001b[0m" },
        { "type": "custom", "format": "\u001b[37m\"LIQUID FROSTED ACRYLIC · macOS / visionOS ARCHITECTURE\"\u001b[0m" },
        { "type": "separator", "string": "─", "outputColor": "36" },
        { "type": "title", "color": { "user": "1;36", "at": "90", "host": "1;37" } },
        { "type": "os", "key": "[ OS ]      " },
        { "type": "kernel", "key": "[ KERNEL ]  ", "format": "{release}" },
        { "type": "wm", "key": "[ WM ]      ", "format": "{pretty-name}" },
        { "type": "command", "key": "[ SHELL ]   ", "text": "echo 'quickshell · glass'" },
        { "type": "terminal", "key": "[ TERM ]    ", "format": "{pretty-name}" },
        { "type": "terminalfont", "key": "[ FONT ]    " },
        { "type": "uptime", "key": "[ UPTIME ]  " },
        { "type": "memory", "key": "[ MEMORY ]  " },
        "break",
        { "type": "colors", "symbol": "circle" },
        "break"
    ]
}
